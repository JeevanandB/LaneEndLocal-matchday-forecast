	column weekday_no = WEEKDAY ( DimDate[date], 2 )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c4ac6ba2-a5d1-4572-b685-62cde41f87c3
		summarizeBy: none

	/// Slicer label for home matches, e.g. Fri 30 Oct 2026 · 20:00 v Wrexham
	column match_label = IF ( DimDate[is_match_day], FORMAT ( DimDate[date], "ddd dd mmm yyyy" ) & " · " & DimDate[kickoff] & " v " & DimDate[opponent] )
		dataType: string
		lineageTag: a479dec4-5069-4b8f-bdf9-a890a65cf869

	/// Short date label for categorical chart axes.
	column date_label = FORMAT ( DimDate[date], "dd mmm yy" )
		dataType: string
		lineageTag: eb3360cb-0d57-45cb-bc5f-564fa6342164
		sortByColumn: date

	/// Short kick-off band label for the Page 1 chips, with the number of training matches.
	column band_chip =
			VAR b = DimDate[kickoff_band]
			VAR n = COUNTROWS ( FILTER ( ALL ( DimDate ), DimDate[kickoff_band] = b && DimDate[is_match_day] && DimDate[period] = "Train" ) )
			RETURN IF ( b <> "", LEFT ( b, SEARCH ( " ", b & " " ) - 1 ) & " · " & n )
		dataType: string
		lineageTag: 4b46ce47-f04e-4a0d-b950-b70d83ad537e
		sortByColumn: band_order

	column band_order = SWITCH ( LEFT ( DimDate[kickoff_band], 5 ), "Early", 1, "After", 2, "Eveni", 3, 9 )
		dataType: int64
		isHidden
		lineageTag: 496ff03a-a013-481d-a490-a7e347ae94db
		summarizeBy: none

