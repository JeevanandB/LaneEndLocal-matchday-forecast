	/// Top 12 by uplift plus Milk 2pt and White Bread (as in the HTML).
	column show_on_uplift_chart = VAR r = RANKX ( SkuMatchUplift, SkuMatchUplift[uplift_at_27500], , DESC, Skip ) RETURN r <= 12 || SkuMatchUplift[sku_id] IN { "SKU133", "SKU129" }
		dataType: boolean
		lineageTag: 55a61da0-499e-4aec-a832-b372bd4a56fe

	column short_name = LOOKUPVALUE ( DimProduct[short_name], DimProduct[sku_id], SkuMatchUplift[sku_id] )
		dataType: string
