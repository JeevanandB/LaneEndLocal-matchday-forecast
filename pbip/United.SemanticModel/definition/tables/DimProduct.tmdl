	/// The 8 products that matter most on match days (Page 2).
	column is_key_line = DimProduct[sku_id] IN { "SKU108", "SKU120", "SKU109", "SKU100", "SKU103", "SKU131", "SKU132", "SKU133" }
		dataType: boolean
		lineageTag: dd8644f2-d5a8-4757-8e30-457dea5c1eff

	column key_line_order = SWITCH ( DimProduct[sku_id], "SKU108", 1, "SKU120", 2, "SKU109", 3, "SKU100", 4, "SKU103", 5, "SKU131", 6, "SKU132", 7, "SKU133", 8, 100 + VALUE ( RIGHT ( DimProduct[sku_id], 3 ) ) )
		dataType: int64
		isHidden
		lineageTag: 1fe786b6-5c72-48f2-8579-be314a006848
		summarizeBy: none

